        </mxCell>
        <mxCell id="d6" value="&lt;b&gt;调试难度&lt;/b&gt;" style="rounded=1;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=11;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="560" y="640" width="130" height="35" as="geometry" />
        </mxCell>
        <!-- 左侧内容 -->
        <mxCell id="l1" value="&lt;b&gt;极高&lt;/b&gt; — Modbus/OPC UA/PROFIBUS&lt;br&gt;与传感器、执行器深度耦合" style="rounded=1;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontColor=#1B3A5C;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;毫秒/微秒级&lt;/b&gt; — 硬实时&lt;br&gt;延迟=安全事故，确定性响应" style="rounded=1;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontColor=#1B3A5C;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="230" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;安全关键&lt;/b&gt; — 冗余设计、故障容错&lt;br&gt;符合IEC 61508等安全标准" style="rounded=1;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontColor=#1B3A5C;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="330" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="&lt;b&gt;深度嵌入&lt;/b&gt; — PID控制、热力学模型&lt;br&gt;物理机理 + 行业规范" style="rounded=1;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontColor=#1B3A5C;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="430" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="&lt;b&gt;20年以上&lt;/b&gt; — 长期维护与演化&lt;br&gt;平台化 + 软件定义制造" style="rounded=1;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontColor=#1B3A5C;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="530" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l6" value="&lt;b&gt;极困难&lt;/b&gt; — 需HIL仿真/Mock硬件&lt;br&gt;虚实结合 + 极限工况" style="rounded=1;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontColor=#1B3A5C;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="630" width="280" height="50" as="geometry" />
        </mxCell>
        <!-- 右侧内容 -->
        <mxCell id="r1" value="&lt;b&gt;低&lt;/b&gt; — 通过API/HTTP&lt;br&gt;不直接控制物理设备" style="rounded=1;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;fontColor=#4E342E;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="130" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;秒级/最佳努力&lt;/b&gt;&lt;br&gt;软实时，可接受偶尔延迟" style="rounded=1;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;fontColor=#4E342E;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="230" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;中等&lt;/b&gt; — 容忍一定故障率&lt;br&gt;快速修复 &amp; 回滚" style="rounded=1;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;fontColor=#4E342E;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="330" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;业务逻辑驱动&lt;/b&gt;&lt;br&gt;用户需求为主，CRUD/数据处理" style="rounded=1;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;fontColor=#4E342E;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="430" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;2-5年&lt;/b&gt; — 快速迭代/重写&lt;br&gt;技术栈更新快" style="rounded=1;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;fontColor=#4E342E;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="530" width="280" height="50" as="geometry" />
