        <mxCell id="cat3-example" value="&lt;font color=&quot;#888&quot;&gt;&lt;i&gt;代表：SAP、Oracle、用友、金蝶&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="640" y="415" width="240" height="25" as="geometry" />
        </mxCell>
        <!-- 分类4: 嵌入式软件 -->
