        <mxCell id="e-root-cat4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#555;strokeWidth=2;" edge="1" parent="1" source="root" target="cat4">
          <mxGeometry relative="1" as="geometry" />
