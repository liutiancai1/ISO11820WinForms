  <diagram id="classification-1" name="工业软件分类体系">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- 标题 -->
        <mxCell id="title" value="&lt;font style=&quot;font-size:20px;&quot;&gt;&lt;b&gt;图1-2 工业软件分类体系&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="20" width="350" height="40" as="geometry" />
        </mxCell>
        <!-- 根节点 -->
        <mxCell id="root" value="&lt;b&gt;工业软件&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Industrial Software&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#16213e;fontColor=#FFFFFF;fontSize=14;arcSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="180" height="60" as="geometry" />
        </mxCell>
        <!-- 分类1: 研发设计类 -->
        <mxCell id="cat1" value="&lt;b&gt;研发设计类&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2196F3;strokeColor=#1565C0;fontColor=#FFFFFF;fontSize=13;arcSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-root-cat1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#555;strokeWidth=2;" edge="1" parent="1" source="root" target="cat1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cat1-items" value="&lt;div style=&quot;text-align:left;padding:8px;&quot;&gt;• &lt;b&gt;CAD&lt;/b&gt; 计算机辅助设计&lt;br&gt;• &lt;b&gt;CAE&lt;/b&gt; 计算机辅助工程&lt;br&gt;• &lt;b&gt;CAPP&lt;/b&gt; 辅助工艺规划&lt;br&gt;• &lt;b&gt;CAM&lt;/b&gt; 辅助制造&lt;br&gt;• &lt;b&gt;PLM&lt;/b&gt; 产品生命周期管理&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontColor=#1B3A5C;arcSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e-cat1-items" value="" style="endArrow=none;html=1;strokeColor=#1565C0;strokeWidth=1;dashed=1;" edge="1" parent="1" source="cat1" target="cat1-items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cat1-example" value="&lt;font color=&quot;#888&quot;&gt;&lt;i&gt;代表：达索、Autodesk、中望&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="40" y="425" width="240" height="25" as="geometry" />
        </mxCell>
        <!-- 分类2: 生产管控类 -->
        <mxCell id="cat2" value="&lt;b&gt;生产管控类&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9800;strokeColor=#E65100;fontColor=#FFFFFF;fontSize=13;arcSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="220" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-root-cat2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#555;strokeWidth=2;" edge="1" parent="1" source="root" target="cat2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cat2-items" value="&lt;div style=&quot;text-align:left;padding:8px;&quot;&gt;• &lt;b&gt;MES&lt;/b&gt; 制造执行系统&lt;br&gt;• &lt;b&gt;APS&lt;/b&gt; 高级计划排程&lt;br&gt;• &lt;b&gt;SCADA&lt;/b&gt; 数据采集与监控&lt;br&gt;• &lt;b&gt;DCS&lt;/b&gt; 分布式控制系统&lt;br&gt;• &lt;b&gt;PLC&lt;/b&gt; 编程软件&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;fontColor=#4E342E;arcSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e-cat2-items" value="" style="endArrow=none;html=1;strokeColor=#E65100;strokeWidth=1;dashed=1;" edge="1" parent="1" source="cat2" target="cat2-items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cat2-example" value="&lt;font color=&quot;#888&quot;&gt;&lt;i&gt;代表：西门子、GE、宝信软件&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="340" y="425" width="240" height="25" as="geometry" />
        </mxCell>
        <!-- 分类3: 经营管理类 -->
        <mxCell id="cat3" value="&lt;b&gt;经营管理类&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#2E7D32;fontColor=#FFFFFF;fontSize=13;arcSize=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="220" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-root-cat3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#555;strokeWidth=2;" edge="1" parent="1" source="root" target="cat3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cat3-items" value="&lt;div style=&quot;text-align:left;padding:8px;&quot;&gt;• &lt;b&gt;ERP&lt;/b&gt; 企业资源计划&lt;br&gt;• &lt;b&gt;CRM&lt;/b&gt; 客户关系管理&lt;br&gt;• &lt;b&gt;SCM&lt;/b&gt; 供应链管理&lt;br&gt;• &lt;b&gt;EAM&lt;/b&gt; 企业资产管理&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontColor=#1B5E20;arcSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="640" y="300" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e-cat3-items" value="" style="endArrow=none;html=1;strokeColor=#2E7D32;strokeWidth=1;dashed=1;" edge="1" parent="1" source="cat3" target="cat3-items">
          <mxGeometry relative="1" as="geometry" />
