        <mxCell id="r6" value="&lt;b&gt;相对容易&lt;/b&gt; — 纯软件环境测试&lt;br&gt;自动化测试成熟" style="rounded=1;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;fontColor=#4E342E;align=left;spacingLeft=8;" vertex="1" parent="1">
