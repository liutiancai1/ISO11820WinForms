          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cat4-example" value="&lt;font color=&quot;#888&quot;&gt;&lt;i&gt;应用：数控机床、传感器、PLC&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1">
